{
  "name": "high-throughput-rest-api-platform",
  "version": "1.0.0",
  "private": true,
  "description": "A Fastify REST API demonstrating PostgreSQL access patterns, Redis caching, and load testing.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "bench": "node bench.js",
    "test:load": "k6 run load.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "redis": "^4.7.0"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}